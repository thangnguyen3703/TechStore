@using TechStore.Shared_ViewModels
@model PaginationViewModel

<div class="d-flex justify-content-between align-items-center w-100">

    <!-- Số dòng / trang -->
    <form method="get"
          class="d-flex align-items-center gap-2 mb-0">

        <span>Hiển thị</span>

        <select name="pageSize"
                class="form-select form-select-sm"
                style="width: 80px;"
                onchange="this.form.submit()">

            <option value="10"
                    selected="@(Model.PageSize == 10 ? "selected" : null)">
                10
            </option>

            <option value="20"
                    selected="@(Model.PageSize == 20 ? "selected" : null)">
                20
            </option>

            <option value="50"
                    selected="@(Model.PageSize == 50 ? "selected" : null)">
                50
            </option>

            <option value="100"
                    selected="@(Model.PageSize == 100 ? "selected" : null)">
                100
            </option>

        </select>

        <span>dòng</span>

        <input type="hidden"
               name="page"
               value="1" />
    </form>


    <!-- Số trang -->
    @if (Model.TotalPages > 1)
    {
        var startPage = Math.Max(1, Model.Page - 2);
        var endPage = Math.Min(Model.TotalPages, Model.Page + 2);

        <nav>
            <ul class="pagination pagination-sm mb-0">

                <!-- Previous -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize">
                        &laquo;
                    </a>
                </li>

                @for (var i = startPage; i <= endPage; i++)
                {
                    var pageNumber = i;

                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">

                        <a class="page-link"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize">
                            @pageNumber
                        </a>

                    </li>
                }

                <!-- Next -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">

                    <a class="page-link"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize">
                        &raquo;
                    </a>

                </li>

            </ul>
        </nav>
    }

</div>