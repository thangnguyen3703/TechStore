@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="py-5 my-5" id="login-form">
    <div class="container-sm">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="breadcrumbs pt-5 my-5">
                    <span class="item"><a asp-controller="Home" asp-action="Index">Home /</a></span>
                    <span class="item">My Account</span>
                </div>
                <h2 class="section-title text-uppercase">Login</h2>
                <div class="alert alert-info" role="status">
                    Giao diện đăng nhập đã được migrate. Form sẽ được nối với authentication service của project mới.
                </div>
                <form class="form-group flex-wrap">
                    <div class="col-12 pb-3">
                        <label for="Email" class="form-label">Email</label>
                        <input id="Email" name="Email" type="email" class="form-control" autocomplete="email"
                               placeholder="Write your email address here" disabled />
                    </div>
                    <div class="col-12 pb-3">
                        <label for="Password" class="form-label">Password</label>
                        <input id="Password" name="Password" type="password" class="form-control"
                               autocomplete="current-password" placeholder="Enter your password" disabled />
                    </div>
                    <button type="button" class="btn btn-dark text-uppercase w-100" disabled>Log In</button>
                </form>
            </div>
        </div>
    </div>
</section>
