@using TechStore.Shared_ViewModels
@model List<BranchListViewModel>

@{
    ViewData["Title"] = "Quản lý chi nhánh";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Quản lý chi nhánh</h4>
            <p class="text-muted mb-0">Danh sách các chi nhánh trong hệ thống</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Branch"
           asp-action="Create"
           class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>
            Thêm chi nhánh
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted mb-0">Chưa có chi nhánh nào.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 80px;">#</th>
                                <th>Mã chi nhánh</th>
                                <th>Tên chi nhánh</th>
                                <th>Địa chỉ</th>
                                <th>Số điện thoại</th>
                                <th>Email</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center" style="width: 150px;">
                                    Thao tác
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var index = 1;
                            }

                            @foreach (var branch in Model)
                            {
                                <tr>
                                    <td>@index</td>

                                    <td>
                                        <strong>@branch.Code</strong>
                                    </td>

                                    <td>@branch.Name</td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(branch.Address)
                                                                        ? "-"
                                                                        : branch.Address)
                                                                                     </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(branch.Phone)
                                                                        ? "-"
                                                                        : branch.Phone)
                                                                                   </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(branch.Email)
                                                                        ? "-"
                                                                        : branch.Email)
                            </td>

                                    <td class="text-center">
                                @if (branch.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Ngừng hoạt động
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a asp-area="Admin"
                                           asp-controller="Branch"
                                           asp-action="Edit"
                                           asp-route-id="@branch.BranchId"
                                           class="btn btn-sm btn-warning"
                                           title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Branch"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@branch.BranchId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(branch.IsActive ? "btn-danger" : "btn-success")"
                                                    title="@(branch.IsActive ? "Ngừng hoạt động" : "Kích hoạt")">
                                                @if (branch.IsActive)
                                                {
                                                    <i class="fas fa-lock"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-unlock"></i>
                                                }
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>