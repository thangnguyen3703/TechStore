@using TechStore.Shared_ViewModels
@using TechStore.Service
@model PagedResult<BranchListViewModel>

@{
    ViewData["Title"] = "Quản lý chi nhánh";
}

<style>
    .branch-table-card {
        height: 650px;
        overflow: hidden;
    }

        .branch-table-card .card-body {
            flex: 1;
            min-height: 0;
            overflow: auto;
        }

        .branch-table-card .card-footer {
            flex: 0 0 70px;
            background: #fff;
            display: flex;
            align-items: center;
        }

        /* Khi bảng dài thì scroll nhưng header vẫn đứng yên */
        .branch-table-card thead th {
            position: sticky;
            top: 0;
            background: #fff;
            z-index: 2;
        }
</style>


<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Quản lý chi nhánh</h4>
            <p class="text-muted mb-0">
                Danh sách các chi nhánh trong hệ thống
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Branch"
           asp-action="Create"
           class="btn btn-primary">

            <i class="fas fa-plus me-1"></i>
            Thêm chi nhánh

        </a>
    </div>


    <div class="card shadow-sm branch-table-card d-flex flex-column">

        <!-- Vùng dữ liệu -->
        <div class="card-body">

            @if (Model == null || !Model.Items.Any())
            {
                <div class="d-flex justify-content-center align-items-center h-100">
                    <p class="text-muted mb-0">
                        Chưa có chi nhánh nào.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>
                                <th style="width: 80px;">#</th>
                                <th>Mã chi nhánh</th>
                                <th>Tên chi nhánh</th>
                                <th>Địa chỉ</th>
                                <th>Số điện thoại</th>
                                <th>Email</th>
                                <th class="text-center">
                                    Trạng thái
                                </th>

                                <th class="text-center"
                                    style="width: 150px;">
                                    Thao tác
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                var index =
                                (Model.Page - 1) * Model.PageSize + 1;
                            }

                            @foreach (var branch in Model.Items)
                            {
                                <tr>

                                    <td>@index</td>

                                    <td>
                                        <strong>@branch.Code</strong>
                                    </td>

                                    <td>
                                        @branch.Name
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(branch.Address)
                                                                        ? "-"
                                                                        : branch.Address)
                                                                                     </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(branch.Phone)
                                                                        ? "-"
                                                                        : branch.Phone)
                                                                                   </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(branch.Email)
                                                                        ? "-"
                                                                        : branch.Email)
                            </td>

                                    <td class="text-center">

                                @if (branch.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Ngừng hoạt động
                                            </span>
                                        }

                                    </td>


                                    <td class="text-center">

                                        <!-- Edit -->
                                        <a asp-area="Admin"
                                           asp-controller="Branch"
                                           asp-action="Edit"
                                           asp-route-id="@branch.BranchId"
                                           class="btn btn-sm btn-warning"
                                           title="Chỉnh sửa">

                                            <i class="fas fa-edit"></i>

                                        </a>


                                        <!-- Toggle Status -->
                                        <form asp-area="Admin"
                                              asp-controller="Branch"
                                              asp-action="ToggleStatus"
                                              asp-route-id="@branch.BranchId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(branch.IsActive ? "btn-danger" : "btn-success")"
                                                    title="@(branch.IsActive ? "Ngừng hoạt động" : "Kích hoạt")">

                                                @if (branch.IsActive)
                                                {
                                                    <i class="fas fa-lock"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-unlock"></i>
                                                }

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                                index++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


        <!-- Pagination cố định dưới card -->
        <div class="card-footer">

            <partial name="_Pagination"
                     model="Model" />

        </div>

    </div>

</div>