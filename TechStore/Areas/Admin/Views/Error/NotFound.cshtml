@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - Spark Admin</title>
    
    <!-- SEO Optimization -->
    <meta name="description" content="404 Page Not Found - Spark Admin Premium Bootstrap 5 Admin Dashboard Template">
    <meta name="author" content="Spark Admin Team">
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" asp-append-version="true" href="~/admin/assets/images/favicon.ico">
    
    <!-- Local Third-Party Libraries (100% Offline Compatible) -->
    <link rel="stylesheet" asp-append-version="true" href="~/admin/assets/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" asp-append-version="true" href="~/admin/assets/libs/bootstrap-icons/bootstrap-icons.css">
    
    <!-- Main Design System & Custom Stylesheet -->
    <link rel="stylesheet" asp-append-version="true" href="~/admin/assets/css/main.css">
</head>
<body>

    <!-- ==========================================
         START: 404 Error Page Container & Card
         ========================================== -->
    <div class="login-wrapper">
        <!-- Glowing background shapes matching theme aesthetic -->
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>
        
        <!-- Main centered error card layout -->
        <div class="login-card text-center">
            
            <!-- Brand Identity -->
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="login-brand text-decoration-none">
                <i class="bi bi-asterisk"></i>
                <span>Spark Admin</span>
            </a>
            
            <!-- Giant 404 header with spinning asterisk Zero -->
            <div class="error-title-huge">
                <span>4</span>
                <i class="bi bi-asterisk"></i>
                <span>4</span>
            </div>
            
            <h2 class="error-subtitle">Page Not Found</h2>
            <p class="error-desc">
                The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
            </p>
            
            <div class="error-actions-group">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn-custom btn-custom-primary">
                    <i class="bi bi-house"></i> Back to Dashboard
                </a>
            </div>
            
        </div>
    </div>
    <!-- END: 404 Error Page Container -->

    <!-- Local Third-Party Libraries Script dependencies -->
    <script asp-append-version="true" src="~/admin/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
