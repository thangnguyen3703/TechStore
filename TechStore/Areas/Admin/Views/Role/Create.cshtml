@model RoleFormViewModel
@{
    ViewData["Title"] = "Thêm Role";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Thêm Role</h1>
        <p class="page-subtitle">Tạo một nhóm quyền mới cho hệ thống.</p>
    </div>
    <a asp-action="Index" class="btn-custom btn-custom-light">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            <form asp-area="Admin" asp-controller="Role" asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label-custom"></label>
                    <input asp-for="Name" class="form-control-custom" placeholder="Ví dụ: BranchManager" autocomplete="off" />
                    <span asp-validation-for="Name" class="form-feedback-custom invalid-custom"></span>
                    <div class="form-text">Tên được tự động loại bỏ khoảng trắng ở đầu và cuối.</div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-custom btn-custom-light">Hủy</a>
                    <button type="submit" class="btn-custom btn-custom-primary">
                        <i class="bi bi-check-lg"></i> Tạo Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
