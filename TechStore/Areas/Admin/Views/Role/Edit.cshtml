@model RoleFormViewModel
@{
    ViewData["Title"] = "Sửa Role";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Sửa Role</h1>
        <p class="page-subtitle">Cập nhật tên nhóm quyền.</p>
    </div>
    <a asp-action="Index" class="btn-custom btn-custom-light">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-7 col-lg-9">
        <div class="card">
            @if (Model.IsSystemRole)
            {
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-shield-lock-fill me-2"></i>
                    Role Admin là role hệ thống và không thể đổi tên.
                </div>
            }

            <form asp-area="Admin" asp-controller="Role" asp-action="Edit" method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Name" class="form-label-custom"></label>
                    <input asp-for="Name" class="form-control-custom" disabled="@Model.IsSystemRole" autocomplete="off" />
                    <span asp-validation-for="Name" class="form-feedback-custom invalid-custom"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-custom btn-custom-light">Quay lại</a>
                    @if (!Model.IsSystemRole)
                    {
                        <button type="submit" class="btn-custom btn-custom-primary">
                            <i class="bi bi-check-lg"></i> Lưu thay đổi
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
