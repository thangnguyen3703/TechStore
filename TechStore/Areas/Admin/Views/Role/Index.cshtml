@model IReadOnlyList<RoleViewModel>
@{
    ViewData["Title"] = "Role Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Role Management</h1>
        <p class="page-subtitle">Quản lý các nhóm quyền sử dụng trong hệ thống.</p>
    </div>
    <a asp-area="Admin" asp-controller="Role" asp-action="Create" class="btn-custom btn-custom-primary">
        <i class="bi bi-plus-lg"></i> Thêm Role
    </a>
</div>

@await Html.PartialAsync("_AdminAlerts")

<div class="card table-card-custom">
    <div class="table-responsive">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Tên role</th>
                    <th>Người dùng</th>
                    <th>Loại</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">Chưa có role nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="transaction-icon bg-forest-light text-lime">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <strong>@role.Name</strong>
                                </div>
                            </td>
                            <td>@role.UserCount</td>
                            <td>
                                @if (role.IsSystemRole)
                                {
                                    <span class="badge-table success">Role hệ thống</span>
                                }
                                else
                                {
                                    <span class="badge-table pending">Tùy chỉnh</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (role.IsSystemRole)
                                {
                                    <span class="text-muted small">Không thể sửa hoặc xóa</span>
                                }
                                else
                                {
                                    <div class="d-inline-flex gap-2">
                                        <a asp-area="Admin" asp-controller="Role" asp-action="Edit" asp-route-id="@role.Id"
                                           class="table-btn-action" title="Sửa role" aria-label="Sửa role">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="Role" asp-action="Delete" method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa role này?');">
                                            <input type="hidden" name="id" value="@role.Id" />
                                            <button type="submit" class="table-btn-action delete border-0" title="Xóa role" aria-label="Xóa role">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
