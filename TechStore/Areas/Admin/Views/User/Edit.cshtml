@model UserEditViewModel
@{
    ViewData["Title"] = "Sửa User";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Sửa User</h1>
        <p class="page-subtitle">Cập nhật trạng thái và role của tài khoản.</p>
    </div>
    <a asp-action="Index" class="btn-custom btn-custom-light">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

@await Html.PartialAsync("_AdminAlerts")

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Thông tin tài khoản</h2>
            </div>

            <form asp-area="Admin" asp-controller="User" asp-action="Edit" method="post">
                <input asp-for="UserId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label-custom"></label>
                    <input asp-for="Email" class="form-control-custom" readonly />
                    <div class="form-text">Email đồng thời là username và không đổi trong màn hình này.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom">Role</label>
                    <div class="row g-3">
                        @if (Model.AvailableRoles.Count == 0)
                        {
                            <div class="col-12 text-muted">Chưa có role nào để gán.</div>
                        }
                        else
                        {
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <div class="col-md-6">
                                    <label class="form-check-custom">
                                        <input class="form-check-input-custom" type="checkbox" name="SelectedRoleNames"
                                               value="@role.Name" checked="@role.IsSelected" />
                                        <span>@role.Name</span>
                                    </label>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="form-switch-custom mb-4">
                    <input asp-for="IsActive" class="form-switch-input-custom" />
                    <label asp-for="IsActive" class="form-label-custom mb-0"></label>
                </div>
                <span asp-validation-for="IsActive" class="form-feedback-custom invalid-custom"></span>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn-custom btn-custom-light">Hủy</a>
                    <button type="submit" class="btn-custom btn-custom-primary">
                        <i class="bi bi-check-lg"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card" id="reset-password">
            <div class="card-header">
                <h2 class="card-title">Reset mật khẩu</h2>
            </div>
            <p class="text-muted">Đặt mật khẩu mới bằng password reset token của Identity.</p>

            <form asp-area="Admin" asp-controller="User" asp-action="ResetPassword" method="post">
                <input type="hidden" name="UserId" value="@Model.UserId" />
                <div class="mb-3">
                    <label for="NewPassword" class="form-label-custom">Mật khẩu mới</label>
                    <input type="password" id="NewPassword" name="NewPassword" class="form-control-custom"
                           autocomplete="new-password" required />
                </div>
                <div class="mb-4">
                    <label for="ConfirmPassword" class="form-label-custom">Xác nhận mật khẩu mới</label>
                    <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control-custom"
                           autocomplete="new-password" required />
                </div>
                <button type="submit" class="btn-custom btn-custom-warning w-100">
                    <i class="bi bi-key-fill"></i> Reset mật khẩu
                </button>
            </form>
        </div>
    </div>
</div>
