@model IReadOnlyList<UserViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Quản lý tài khoản, trạng thái hoạt động và role.</p>
    </div>
    <a asp-area="Admin" asp-controller="User" asp-action="Create" class="btn-custom btn-custom-primary">
        <i class="bi bi-person-plus-fill"></i> Thêm User
    </a>
</div>

@await Html.PartialAsync("_AdminAlerts")

<div class="card table-card-custom">
    <div class="table-responsive">
        <table class="table table-custom align-middle mb-0">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">Chưa có user nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="table-user-cell">
                                    <span class="transaction-icon bg-forest-light text-lime">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <div>
                                        <div class="table-user-name">@user.Email</div>
                                        <div class="table-user-sub">ID: @user.UserId</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (user.RoleNames.Count == 0)
                                {
                                    <span class="text-muted">Chưa gán role</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var roleName in user.RoleNames)
                                        {
                                            <span class="badge rounded-pill text-bg-light border">@roleName</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge-table @(user.IsActive ? "success" : "failed")">
                                    @(user.IsActive ? "Hoạt động" : "Đã khóa")
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-inline-flex align-items-center gap-2">
                                    <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.UserId"
                                       class="table-btn-action" title="Sửa user" aria-label="Sửa user">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-area="Admin" asp-controller="User" asp-action="ToggleActive"
                                          asp-route-id="@user.UserId" method="post">
                                        <button type="submit" class="table-btn-action border-0 @(user.IsActive ? "delete" : string.Empty)"
                                                title="@(user.IsActive ? "Khóa user" : "Mở khóa user")"
                                                aria-label="@(user.IsActive ? "Khóa user" : "Mở khóa user")">
                                            <i class="bi @(user.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>
                                    <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@user.UserId"
                                       asp-fragment="reset-password" class="table-btn-action" title="Reset mật khẩu" aria-label="Reset mật khẩu">
                                        <i class="bi bi-key"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
